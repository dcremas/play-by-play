# Copy to .env and fill in. .env is gitignored -- never commit the key.

# Google AI Studio key for Gemini. GOOGLE_API_KEY is also accepted, so a shell that
# already has one for another app works without change.
PBPX_API_KEY=

# Claude API key, from platform.claude.com (Console) -- NOT a claude.ai Team/Pro login,
# which does not include API access. Only read when PBPX_MODEL is a claude-* model.
ANTHROPIC_API_KEY=

# Keys for the other providers (llm.py). Each is read only when PBPX_MODEL names that
# provider, so any number can stay filled in and switching is just the PBPX_MODEL line.
# OPENAI_API_KEY=        openai:gpt-6-astra
# OPENROUTER_API_KEY=    openrouter:qwen/qwen3.8-max   (one key, most models)
# DEEPSEEK_API_KEY=      deepseek:deepseek-flash
# DASHSCOPE_API_KEY=     qwen:qwen3.8-max
# MOONSHOT_API_KEY=      kimi:kimi-k3
# MISTRAL_API_KEY=       mistral:mistral-medium-latest
# TOGETHER_API_KEY=      together:<model id from their catalogue>
# GROQ_API_KEY=          groq:<model id>
# FIREWORKS_API_KEY=     fireworks:<model id>

# The two MCP servers. One per league; the selector picks between them.
PBPX_MCP_URL_CFB=http://127.0.0.1:8771/mcp
PBPX_MCP_URL_NFL=http://127.0.0.1:8772/mcp

# A bare gemini-* or claude-* name (e.g. claude-sonnet-5-5), or provider:model for the
# rest -- see the keys above. Re-check the spend caps below after a switch: they are
# token counts, and a token does not cost the same everywhere.
PBPX_MODEL=gemini-4-argon

# Spend caps. Tighter on the box than here: that endpoint is public. See budget.py for
# why nginx cannot enforce these.
PBPX_MAX_SESSION_QUESTIONS=12
PBPX_MAX_DAILY_TOKENS=2000000
