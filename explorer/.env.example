# Copy to .env and fill in. .env is gitignored -- never commit the key.

# Google AI Studio key for Gemini. GOOGLE_API_KEY is also accepted, so a shell that
# already has one for another app works without change.
PBPX_API_KEY=

# The two MCP servers. One per league; the selector picks between them.
PBPX_MCP_URL_CFB=http://127.0.0.1:8771/mcp
PBPX_MCP_URL_NFL=http://127.0.0.1:8772/mcp

PBPX_MODEL=gemini-3.8-flash

# Spend caps. Tighter on the box than here: that endpoint is public. See budget.py for
# why nginx cannot enforce these.
PBPX_MAX_SESSION_QUESTIONS=12
PBPX_MAX_DAILY_TOKENS=2000000
