# Copy to .env and fill in. .env is gitignored -- never commit the password.
#
# The password for the pbp_ro role. This role is THIS SERVER'S ALONE: it is not
# the shared mcp_ro the weather warehouse MCP uses, and rotating it cannot break
# that server. See setup_role_pbp.sql for why the two were split.
#
# The role has no password until someone sets one:
#     sudo -u postgres psql -d pbp -c "ALTER ROLE pbp_ro PASSWORD '<value>'"
MCP_DB_PASSWORD=

# Defaults shown; override only if your tunnel differs. On the EC2 box the
# systemd unit sets these to 127.0.0.1:5432 instead -- Postgres is local there,
# so there is no tunnel and no 15432.
MCP_DB_HOST=127.0.0.1
MCP_DB_PORT=15432
MCP_DB_USER=pbp_ro
MCP_DB_NAME=pbp
