# Copy to .env and fill in. .env is gitignored -- never commit the password.
#
# The password for the mcp_ro role. This is the SAME role the weather warehouse
# MCP uses (one role, granted per database, is the convention on this box), so
# if that server already works, reuse the password from
# ~/projects/ec2-nginx/weather-sql-explorer/mcp_server/.env rather than setting
# a new one. Changing it means changing it for both.
MCP_DB_PASSWORD=

# Defaults shown; override only if your tunnel differs.
MCP_DB_HOST=127.0.0.1
MCP_DB_PORT=15432
MCP_DB_USER=mcp_ro
MCP_DB_NAME=pbp
